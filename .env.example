# Postgres connection string. Supabase's pooler string works.
# Transaction pooler (port 6543): the app sets prepare:false.
DATABASE_URL=postgresql://postgres.example:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Bearer token for /api/admin/* routes.
ADMIN_TOKEN=replace-with-a-long-random-string

# Resend. Signup syncs only when both the key and the audience id are set.
# RESEND_AUDIENCE_ID is a segment id (current API) or a legacy audience id.
RESEND_API_KEY=re_xxxxxxxx
RESEND_AUDIENCE_ID=
RESEND_FROM=newsletter@mail.belairestudio.com

# Comma-separated inboxes for sponsor "Get in touch" notifications.
SPONSOR_NOTIFY_EMAILS=hello@belairestudio.com

# Canonical origin. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://cost.belairestudio.com
